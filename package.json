{
  "name": "@tanishraj/ui-kit",
  "version": "2.6.0",
  "description": "A production-ready React component library with modern tooling, Storybook docs, and TypeScript support.",
  "author": "Tanishraj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanishraj/ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/tanishraj/ui-kit/issues"
  },
  "homepage": "https://github.com/tanishraj/ui-kit#readme",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./globals.css": {
      "import": "./dist/globals.css",
      "require": "./dist/globals.css",
      "default": "./dist/globals.css"
    },
    "./base.css": {
      "import": "./dist/colors/base.css",
      "require": "./dist/colors/base.css",
      "default": "./dist/colors/base.css"
    },
    "./animation.css": {
      "import": "./dist/animation.css",
      "require": "./dist/animation.css",
      "default": "./dist/animation.css"
    },
    "./theme-indigo.css": {
      "import": "./dist/themes/indigo.css",
      "require": "./dist/themes/indigo.css",
      "default": "./dist/themes/indigo.css"
    },
    "./theme-violet.css": {
      "import": "./dist/themes/violet.css",
      "require": "./dist/themes/violet.css",
      "default": "./dist/themes/violet.css"
    },
    "./themes/*": {
      "import": "./dist/themes/*.css",
      "require": "./dist/themes/*.css",
      "default": "./dist/themes/*.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && npm run copy:theme && rm -rf dist/src",
    "copy:theme": "node scripts/copy-theme.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "release:check": "npm run lint && npm run type-check && npm run test -- --run && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist node_modules coverage storybook-static",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:build": "storybook build",
    "type-check": "tsc --noEmit",
    "chromatic": "npx chromatic --project-token=chpt_6d0044a26b550fc"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-org-chart": "^3.1.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-select": "^5.10.2",
    "react-tooltip": "^6.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.58.9",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-org-chart": "^3.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "chromatic": "^17.7.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9"
  }
}
